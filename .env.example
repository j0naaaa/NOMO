# Run npm run setup:local for a fresh installation, then set your equity limits.
# API keys are NOT set here. They are entered on the setup screen at first
# run and stored in the local SQLite database (server/data/app.db).

# Required to store credentials. Supply via the environment or private root .env.
NOMO_SECRET_KEY=

# Placement stays disabled while any USD limit is blank.
NOMO_MAX_ORDER_USD=
NOMO_MAX_POSITION_USD=
NOMO_MAX_TOTAL_USD=

# Port the Express backend listens on
PORT=3001

# Host to bind. Must be a loopback address; the server refuses anything else
# because the app is single user, local only, and fronts a brokerage account.
HOST=127.0.0.1

# Claude model used for chat. Leave unset for the default.
# ANTHROPIC_MODEL=claude-sonnet-5

# SEC EDGAR sends a descriptive User-Agent with every request. For heavier use,
# set your own identifying string with a contact (SEC's fair-access policy).
# SEC_USER_AGENT=your-app-name (your-contact@example.com)
